# Copy this file to backend/.env and fill in the values. Never commit .env.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://hekim:hekim_password@localhost:5432/hekim_db

# JWT signing key. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini, used to draft radiology reports (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Trained model weights (see README: "Model weights")
DENSENET_WEIGHTS_PATH=weights/densenet121_nih.pth
VIT_WEIGHTS_PATH=weights/vit_nih.pt

API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Optional demo admin created on startup. Leave empty to disable (seed_db.py also creates one).
DEFAULT_ADMIN_EMAIL=admin@hekim.com
DEFAULT_ADMIN_PASSWORD=
